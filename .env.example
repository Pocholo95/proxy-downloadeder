# Copy to .env and edit — or, if you're deploying with a stack manager
# (Portainer/Arcane/Dockge/etc.) from this git repo, set these as the
# stack's environment variables instead of editing docker-compose.yml.

# Host port the web UI listens on.
WEB_PORT=8080

# Host paths bind-mounted into the container. Absolute paths recommended
# when set from a stack manager (relative paths resolve against wherever
# the compose file happens to run from).
DOWNLOADS_PATH=./downloads
CONFIG_PATH=./config
STATE_PATH=./state

# Traefik integration — off by default. Requires an external Docker
# network named "proxy" that your Traefik is also attached to.
TRAEFIK_ENABLE=false
TRAEFIK_HOST=downloader.example.com
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
